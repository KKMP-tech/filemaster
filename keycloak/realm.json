{
  "realm": "$(IMPORT_REALM)",
  "enabled": true,
  "duplicateEmailsAllowed": false,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 604800,
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "attributes": {
    "userProfileEnabled": "true",
    "adminEventsExpiration": "1209600"
  },
  "userProfile": {
    "attributes": [
      {
        "name": "username",
        "displayName": "${username}",
        "validations": {
          "length": {
            "min": 3,
            "max": 255
          },
          "username-prohibited-characters": {},
          "up-username-not-idn-homograph": {}
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false
      },
      {
        "name": "email",
        "displayName": "${email}",
        "validations": {
          "email": {},
          "length": {
            "max": 255
          }
        },
        "required": {
          "roles": [
            "user"
          ]
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false
      },
      {
        "name": "firstName",
        "displayName": "${firstName}",
        "validations": {
          "length": {
            "max": 255
          },
          "person-name-prohibited-characters": {}
        },
        "required": {
          "roles": [
            "user"
          ]
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false
      },
      {
        "name": "lastName",
        "displayName": "${lastName}",
        "validations": {
          "length": {
            "max": 255
          },
          "person-name-prohibited-characters": {}
        },
        "required": {
          "roles": [
            "user"
          ]
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false
      },
      {
        "name": "stable-user-id",
        "displayName": "${stable-user-id}",
        "validations": {},
        "annotations": {},
        "permissions": {
          "view": [
            "admin"
          ],
          "edit": [
            "admin"
          ]
        },
        "multivalued": false
      }
    ],
    "groups": [
      {
        "name": "user-metadata",
        "displayHeader": "User metadata",
        "displayDescription": "Attributes, which refer to user metadata"
      }
    ]
  },
  "clients": [
    {
      "clientId": "$(IMPORT_CLIENT_ID)",
      "name": "eDMS SSO",
      "description": "Авторизация в SSO сервисе",
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "frontchannelLogout": true,
      "secret": "$(IMPORT_CLIENT_SECRET)",
      "redirectUris": [
        "https://$(FILEMASTER_DOMAIN)/redirect/"
      ],
      "webOrigins": [
        "https://$(FILEMASTER_DOMAIN)"
      ]
    },
    {
      "id": "24efef37-ed57-4d72-8209-0eb27fe3b68f",
      "clientId": "edms",
      "name": "eDMS",
      "description": "Сервис по работе с документами",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "frontchannelLogout": true,
      "attributes": {
        "realm_client": "false"
      }
    },
    {
      "id": "0c015a81-1741-49e0-9e09-377b01cd0ef5",
      "clientId": "pdf_text_storage",
      "name": "Pdf text storage",
      "description": "Сервис по OCR документов",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "frontchannelLogout": true,
      "attributes": {
        "realm_client": "false"
      }
    },
    {
      "id": "8441f5d1-93d5-44a1-8adf-17afae94a51c",
      "clientId": "previewer",
      "name": "Previewer",
      "description": "Сервис создания превью",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "frontchannelLogout": true,
      "attributes": {
        "realm_client": "false"
      }
    },
    {
      "id": "019dfaa2-6306-4078-a1f8-5caffd66dbc5",
      "clientId": "search",
      "name": "Search",
      "description": "Сервис поиска",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "frontchannelLogout": true,
      "attributes": {
        "realm_client": "false"
      }
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "$(IMPORT_AD_FEDERATION_NAME)",
        "providerId": "ldap",
        "config": {
          "enabled": ["$(IMPORT_AD_ENABLED)"],
          "cachePolicy": ["DEFAULT"],
          "batchSizeForSync": ["1000"],
          "fullSyncPeriod": ["604800"],
          "changedSyncPeriod": ["86400"],
          "useTruststoreSpi": ["always"],
          "editMode": ["READ_ONLY"],
          "importEnabled": ["true"],
          "syncRegistrations": ["false"],
          "vendor": ["ad"],
          "usernameLDAPAttribute": ["sAMAccountName"],
          "rdnLDAPAttribute": ["cn"],
          "uuidLDAPAttribute": ["objectGUID"],
          "userObjectClasses": ["person, organizationalPerson, user"],
          "connectionUrl": ["$(IMPORT_AD_CONNECTION_URL)"],
          "usersDn": ["$(IMPORT_AD_USERS_DN)"],
          "authType": ["simple"],
          "bindDn": ["$(IMPORT_AD_BIND_DN)"],
          "bindCredential": ["$(IMPORT_AD_PASSWORD)"],
          "searchScope": ["2"],
          "validatePasswordPolicy": ["false"],
          "trustEmail": ["false"],
          "connectionPooling": ["true"],
          "pagination": ["true"],
          "allowKerberosAuthentication": ["false"],
          "debug": ["false"],
          "useKerberosForPasswordAuthentication": ["false"],
          "startTls": ["false"]
        },
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sAMAccountName"],
                "user.model.attribute": ["username"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["false"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["givenName"],
                "user.model.attribute": ["firstName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"],
                "user.model.attribute": ["lastName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "user.model.attribute": ["email"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["false"],
                "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "name": "MSAD account controls",
              "providerId": "msad-user-account-control-mapper",
              "config": {
                "always.read.enabled.value.from.ldap": ["true"]
              }
            },
            {
              "name": "kkmp-legal-group-mapper",
              "providerId": "group-ldap-mapper",
              "config": {
                "membership.attribute.type": ["DN"],
                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": ["LOAD_GROUPS_BY_MEMBER_ATTRIBUTE_RECURSIVELY"],
                "groups.dn": ["$(IMPORT_AD_GROUP_MAPPING_DN)"],
                "group.name.ldap.attribute": ["cn"],
                "group.object.classes": ["group"],
                "ignore.missing.groups": ["true"],
                "mapped.group.attributes": ["objectSid,objectGUID"],
                "preserve.group.inheritance": ["false"],
                "membership.ldap.attribute": ["member"],
                "membership.user.ldap.attribute": ["sAMAccountName"],
                "memberof.ldap.attribute": ["memberOf"],
                "drop.non.existing.groups.during.sync": ["true"],
                "groups.path": ["/"]
              }
            },
            {
              "name": "objectSID",
              "providerId": "msad-objectsid-ldap-mapper",
              "config": {
                "ldap.attribute": ["objectSID"],
                "user.model.attribute": ["objectSID"]
              }
            },
            {
              "name": "stable-user-id",
              "providerId": "ldap-object-guid-mapper",
              "subType": "org.keycloak.storage.ldap.mappers.LDAPStorageMapper",
              "config": {
                "ldap.attribute": ["objectGUID"],
                "user.model.attribute": ["stable-user-id"]
              }
            }
          ]
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "adfs",
      "displayName": "$(IMPORT_SAML_IDP_DISPLAY_NAME)",
      "providerId": "saml",
      "enabled": "$(IMPORT_SAML_IDP_ENABLED)",
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "auto-link-with-adfs",
      "config": {
        "syncMode": "FORCE",
        "allowCreate": "true",
        "entityId": "https://$(FILEMASTER_DOMAIN)/keycloak/realms/$(IMPORT_REALM)",
        "idpEntityId": "$(IMPORT_SAML_IDP_ENTITY_ID)",
        "singleSignOnServiceUrl": "$(IMPORT_SAML_IDP_SSO_URL)",
        "singleLogoutServiceUrl": "$(IMPORT_SAML_IDP_SLO_URL)",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:WindowsDomainQualifiedName",
        "principalType": "SUBJECT",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "false",
        "postBindingLogout": "false",
        "wantAuthnRequestsSigned": "false",
        "wantAssertionsSigned": "true",
        "wantAssertionsEncrypted": "false",
        "forceAuthn": "false",
        "validateSignature": "true",
        "useMetadataDescriptorUrl": "true",
        "metadataDescriptorUrl": "$(IMPORT_SAML_IDP_METADATA_URL)",
        "signatureAlgorithm": "RSA_SHA256",
        "xmlSigKeyInfoKeyNameTransformer": "CERT_SUBJECT",
        "allowedClockSkew": "120"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "username-from-subject",
      "identityProviderAlias": "adfs",
      "identityProviderMapper": "saml-username-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "template": "${ATTRIBUTE.http://schemas.microsoft.com/2012/12/certificatecontext/field/subjectname}",
        "target": "LOCAL"
      }
    },
    {
      "name": "email",
      "identityProviderAlias": "adfs",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
        "user.attribute": "email"
      }
    },
    {
      "name": "sid",
      "identityProviderAlias": "adfs",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "SID",
        "user.attribute": "stable-user-id"
      }
    },
    {
      "name": "firstName",
      "identityProviderAlias": "adfs",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "firstName",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "lastName",
      "identityProviderAlias": "adfs",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "lastName",
        "user.attribute": "lastName"
      }
    }
  ],
